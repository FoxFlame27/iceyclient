[Unit]
Description=Icey Client network backend
After=network.target

[Service]
Type=simple
User=icey
WorkingDirectory=/home/icey/icey-network
ExecStart=/usr/bin/node /home/icey/icey-network/server.js
Restart=always
RestartSec=5
Environment=PORT=8787
Environment=DATA_DIR=/home/icey/icey-network/data

[Install]
WantedBy=multi-user.target
