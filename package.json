{
  "name": "icey-client",
  "productName": "Icey Client",
  "version": "1.86.82",
  "description": "A premium Minecraft launcher with an icy theme",
  "author": {
    "name": "Icey Client",
    "email": "iceyclient@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.iceyclient.app",
    "productName": "Icey Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "mod/build/libs/iceymod-mc*.jar",
      "resources/panoramas/**/*",
      "resources/mods/**/*",
      "resources/modpacks/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "src/assets/icon.png",
      "artifactName": "Icey Client-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "Icey Client Setup.${ext}"
    },
    "nsis": {
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerIcon.ico",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "shortcutName": "Icey Client"
    },
    "linux": {
      "target": [
        { "target": "rpm", "arch": ["arm64"] }
      ],
      "icon": "src/assets/icon.png",
      "category": "Game",
      "desktop": {
        "StartupWMClass": "icey-client"
      },
      "extraResources": [
        { "from": "src/assets/iconlinux.png", "to": "iconlinux.png" }
      ],
      "artifactName": "Icey Client-${arch}.${ext}"
    }
  }
}
